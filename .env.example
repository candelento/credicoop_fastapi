CREDICOOP_REALM_URL=https://homoapibccl.bancocredicoop.coop/auth/realms/homologacion
CREDICOOP_CLIENT_ID=30662210877
CREDICOOP_ADHERENTE=661395
CREDICOOP_PRIVATE_KEY_PATH=secrets/30662210877-HOMOprivate.pem
CREDICOOP_API_KEY=REEMPLAZAR_POR_CLAVE_LOCAL_DE_32_CARACTERES_MINIMO
CREDICOOP_JOURNAL_PATH=data/operaciones.sqlite3
CREDICOOP_DRIVE_FOLDER_ID=1xa_14O0TERbR_kPaQhledLGEl0p77m24
CREDICOOP_DRIVE_CREDENTIALS_PATH=credentials.json
CREDICOOP_SUPPLIER_MASTER_PATH=Beneficiarios_Credicoop.xlsx
# Fecha del banco informada para homologación. Actualizar si el banco mueve el ambiente.
CREDICOOP_FECHA_OPERATIVA=2026-08-28
CREDICOOP_TIMEOUT=30
# Loguea request y response de las consultas de movimientos contra la API del banco (true/false).
CREDICOOP_LOG_MOVIMIENTOS=true
# echeqConFirma habilita listar y gestionar eCheqs con firma posterior en BIE.
# Crear hashes con `python scripts/hash_password.py`; configurar sólo hashes, nunca contraseñas.
# CREDICOOP_AUTH_USERS_JSON=[{"username":"IMRCandela","password_hash":"$argon2id$...","role":"admin"},{"username":"IMRMelisa","password_hash":"$argon2id$...","role":"user"}]
CREDICOOP_SESSION_IDLE_MINUTES=15
# true detrás de HTTPS; false sólo para desarrollo local HTTP.
CREDICOOP_SESSION_COOKIE_SECURE=false
CREDICOOP_SCOPES=cuentas transferenciasConFirma echeqConFirma fciConFirma beneficiarioTransferencia beneficiarioEcheq consultaCbuCvuAlias
# Certificado CA específico, sólo si el banco lo entrega:
# CREDICOOP_CA_BUNDLE=secrets/ca-banco.pem
